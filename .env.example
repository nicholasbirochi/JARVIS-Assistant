# Copy this file to .env and fill in what you need. Nothing here is required
# by default -- openWakeWord (the default wake-word engine) needs no account
# or key. Never commit .env.

# Opções: "openwakeword" (padrão -- sem conta/chave, já vem com o modelo
# pt_BR "hey jarvis") | "porcupine" (motor alternativo, precisa de
# PICOVOICE_ACCESS_KEY, uma conta gratuita em console.picovoice.ai).
# WAKE_WORD_ENGINE=openwakeword
# Só necessário se WAKE_WORD_ENGINE=porcupine.
# PICOVOICE_ACCESS_KEY=

# Which input device JARVIS listens on -- matched by substring against
# PvRecorder.get_available_devices(), NOT the system default (-1). Real
# bug this avoids: a Bluetooth accessory (an Apple Watch) had silently
# become the system's default input device, and a whole session listened
# through its mic instead of the laptop's, with zero errors anywhere.
# Falls back to the system default if nothing matches. "MacBook" (not
# "Microphone"/"Microfone") because the model name isn't localized.
# PREFERRED_MIC_NAME_SUBSTRING=MacBook

# Optional overrides -- defaults already work if Ollama runs locally on the default port.
# OLLAMA_HOST=http://localhost:11434
# Opções: qualquer modelo já baixado via `ollama pull <modelo>`. Padrão é
# qwen2.5:7b -- medido ao vivo em 2026-08-08: ~4x mais rápido que o 14b já
# aquecido (1.1s vs 4.7s pra mesma resposta simples), ainda aciona tool
# calls corretamente. Use qwen2.5:14b pra um pouco mais de qualidade, com
# latência real maior.
# JARVIS_MODEL=qwen2.5:7b
# Opções: só "ollama" existe hoje (mantido configurável pra um futuro
# MLXProvider encaixar sem mudar chamadas -- ver assistant/providers.py).
# JARVIS_LLM_PROVIDER=ollama
# How long Ollama keeps the model loaded in memory after the last request --
# its own default (5 minutes) was the dominant cause of slow replies found
# in practice: any gap between JARVIS activations longer than that forces a
# full cold reload (measured ~30s) on the next one.
# OLLAMA_KEEP_ALIVE=30m

# Two claps also activates JARVIS, alongside the wake word -- on by default.
# Amplitude-based detection is more sensitive to mic/room than the wake-word
# engines; tune or disable it here if it triggers too easily (or not enough).
# Run `python -m jarvis calibrate-claps` to see real peak values for your
# own mic/room before guessing a number.
# Opções: "true" (padrão) | "false" (desliga a ativação por palmas, só
# fica a wake word).
# CLAP_ACTIVATION_ENABLED=true
# CLAP_PEAK_THRESHOLD=3500
# CLAP_WINDOW_SECONDS=1.5

# Default is "Felipe (Aprimorada)" -- a good-quality (Enhanced) male pt_BR
# voice, downloaded via System Settings > Accessibility > Spoken Content >
# System Voice > Portuguese (Brazil) > (i) next to a voice name > Enhanced.
# NOT preinstalled -- if it's missing (fresh macOS install, different Mac),
# jarvis/voice/tts.py automatically falls back to Luciana (the only
# good-quality pt_BR voice macOS installs by default) instead of crashing.
#
# The male-sounding names macOS ships out of the box (Eddy, Flo, Grandma,
# Grandpa, Reed, Rocko, Sandy, Shelley) all run on the old "Eloquence"
# engine and sound noticeably robotic in comparison -- avoid those. Siri
# voices (picked in a separate "Siri Voice" selector in that same Settings
# screen) look tempting but are NOT usable here at all -- confirmed
# unreachable both via `say` and via AVSpeechSynthesisVoice directly, not
# just a CLI limitation.
#
# Always use the full identifier, never just the display name -- these
# persona-style names are ambiguous across languages (bare "Eddy" or
# "Felipe" doesn't reliably resolve to the pt_BR one). Find identifiers with:
#   python -c "from AVFoundation import AVSpeechSynthesisVoice as V; [print(v.name(), v.identifier(), v.quality()) for v in V.speechVoices() if v.language()=='pt-BR']"
# TTS_VOICE=com.apple.voice.enhanced.pt-BR.Felipe

# Voice cloning (jarvis/voice/xtts_engine.py) -- default engine, but only
# actually kicks in once BOTH `pip install -e ".[voice-cloning]"` has been
# run AND a reference clip exists at
# ~/Library/Application Support/JARVIS/voice/jarvis_reference.wav (never
# fetched automatically -- see README's "Voz clonada" section for the real
# load-time/latency numbers before relying on this). Missing either one,
# speak() transparently falls back to TTS_VOICE above -- nothing breaks.
# Opções: "xtts" (padrão, voz clonada -- ver acima) | "say" (desliga a
# clonagem, usa sempre a voz do macOS em TTS_VOICE).
# TTS_ENGINE=xtts

# Where site-adapter login sessions (jarvis/sites/) are saved -- cookies for
# your real accounts (Gupy, etc.), so this deliberately defaults to
# ~/Library/Application Support/JARVIS/sites, OUTSIDE the project folder.
# Only change this if that default path itself is inside some other synced
# location on your machine -- never point it at a cloud-synced folder
# (OneDrive/iCloud Drive/Dropbox/etc.), that's the exact thing this exists
# to avoid.
# JARVIS_LOCAL_STATE_DIR=/Users/you/Library/Application Support/JARVIS

# Site adapters run headless by default (no visible window) for preview/apply
# runs; `gupy-login` always forces a real visible window regardless, since a
# human has to be there to type credentials.
# Opções: "true" (padrão, sem janela visível) | "false" (mostra a janela do
# navegador durante preview/apply -- útil enquanto se desenvolve um novo
# adaptador de site).
# SITES_HEADLESS=true

# Confidential per-candidate application answers (RG, CPF, parents' names,
# salary expectation, etc.) are NOT set here -- see
# application_profile.env.example at the repo root for that separate file
# and jarvis/sites/application_profile.py for why it's kept apart from this
# one (real personal data, must never land in this project folder or git).
