        "end_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Date"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "degree",
        "institution"
      ],
      "title": "Education",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "Where a specific fact came from. Attached to individual résumé items\nso conflicting information from different documents can be tracked\ninstead of one silently overwriting another.",
      "properties": {
        "source_path": {
          "title": "Source Path",
          "type": "string"
        },
        "source_type": {
          "enum": [
            "docx",
            "pdf",
            "txt",
            "md",
            "voice",
            "manual"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "read_at": {
          "title": "Read At",
          "type": "string"
        },
        "snippet": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snippet"
        },
        "confidence": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "review_status": {
          "default": "pending",
          "enum": [
            "pending",
            "confirmed",
            "rejected"
          ],
          "title": "Review Status",
          "type": "string"
        }
      },
      "required": [
        "source_path",
        "source_type",
        "read_at"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Experience": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
