        "end_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Date"
        },
        "is_current": {
          "default": false,
          "title": "Is Current",
          "type": "boolean"
        },
        "bullets_pt": {
          "items": {
            "type": "string"
          },
          "title": "Bullets Pt",
          "type": "array"
        },
        "bullets_en": {
          "items": {
            "type": "string"
          },
          "title": "Bullets En",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "company"
      ],
      "title": "Experience",
      "type": "object"
    },
