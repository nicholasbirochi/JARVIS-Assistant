{
  "$defs": {
    "Availability": {
      "additionalProperties": false,
      "description": "Grouped under JobPreferences, not the root -- availability is a\njob-search preference/constraint, not a resume fact.",
      "properties": {
        "status": {
          "default": "unspecified",
          "enum": [
            "immediate",
            "notice_period",
            "date",
            "unspecified"
          ],
          "title": "Status",
          "type": "string"
        },
        "notice_period_days": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notice Period Days"
        },
        "available_from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Available From"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "title": "Availability",
      "type": "object"
    },
    "Bilingual": {
      "additionalProperties": false,
      "description": "Free-text content that already exists in both languages in the\nsource résumés (pt is required, en is optional until translated).",
      "properties": {
        "pt": {
          "title": "Pt",
          "type": "string"
        },
        "en": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "En"
        }
      },
      "required": [
        "pt"
      ],
      "title": "Bilingual",
      "type": "object"
    },
    "Certification": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "hours": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hours"
        },
        "status": {
          "default": "completed",
          "enum": [
            "in_progress",
            "completed"
          ],
          "title": "Status",
          "type": "string"
        },
        "date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "Certification",
      "type": "object"
    },
    "ChangeRecord": {
      "additionalProperties": false,
      "description": "One entry per applied change to the résumé -- the audit trail.",
      "properties": {
        "timestamp": {
          "title": "Timestamp",
          "type": "string"
        },
        "field_path": {
          "title": "Field Path",
          "type": "string"
        },
        "old_value": {
          "default": null,
          "title": "Old Value"
        },
        "new_value": {
          "default": null,
          "title": "New Value"
        },
        "source": {
          "enum": [
            "voice",
            "import",
            "manual_review",
            "proposal_review"
          ],
          "title": "Source",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "timestamp",
        "field_path",
        "source"
      ],
      "title": "ChangeRecord",
      "type": "object"
    },
    "Conflict": {
      "additionalProperties": false,
      "description": "Two sources disagreed on a fact -- registered for human review,\nnever silently resolved by picking one side.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "field_path": {
          "title": "Field Path",
          "type": "string"
        },
        "existing_value": {
          "default": null,
          "title": "Existing Value"
        },
        "proposed_value": {
          "default": null,
          "title": "Proposed Value"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Sources",
          "type": "array"
        },
        "detected_at": {
          "title": "Detected At",
          "type": "string"
        },
        "status": {
          "default": "open",
          "enum": [
            "open",
            "resolved_existing",
            "resolved_proposed",
            "resolved_manual"
          ],
          "title": "Status",
          "type": "string"
        },
        "resolution_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolution Note"
        }
      },
      "required": [
        "id",
        "field_path",
        "detected_at"
      ],
      "title": "Conflict",
      "type": "object"
    },
    "Education": {
      "additionalProperties": false,
      "properties": {
        "degree": {
          "$ref": "#/$defs/Bilingual"
        },
        "institution": {
          "title": "Institution",
          "type": "string"
        },
        "location": {
          "anyOf": [
