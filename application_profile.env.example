# Reference/example only -- every value below is FICTIONAL, just to show
# the expected format. This file is safe to commit (no real data in it) and
# is NOT read by JARVIS at all.
#
# The REAL file JARVIS actually reads lives OUTSIDE this project folder, at:
#   $JARVIS_LOCAL_STATE_DIR/application_profile.env
#   (defaults to ~/Library/Application Support/JARVIS/application_profile.env
#   if JARVIS_LOCAL_STATE_DIR isn't set -- see .env.example)
#
# Deliberately outside the repo and outside any cloud-synced folder
# (OneDrive/iCloud/Dropbox/etc.) -- see jarvis/sites/application_profile.py's
# module docstring for the full reasoning. Never committed, never logged,
# never sent anywhere except straight into a real job-application form field
# you already started filling in, and only for the specific question that
# asked for it.
#
# To set yours up: run JARVIS once (it auto-creates a blank template at the
# real path above via ensure_profile_template()), or just copy this file
# there and replace every value with your own real data. Every field is
# optional -- if a company's screening question asks for something you
# haven't filled in here, JARVIS stops and asks instead of guessing.
#
# Format: plain KEY=value, one per line, "#" comments and blank lines ignored.

# Government ID (RG) and its issuing authority/state -- classic Brazilian
# employment-form fields, not always asked but common enough to keep ready.
JARVIS_APPLICATION_RG=12.345.678-9
JARVIS_APPLICATION_RG_ORGAO_ESTADO=SSP-SP

JARVIS_APPLICATION_CPF=123.456.789-00

# Identity-verification fields some companies' screening forms ask for.
JARVIS_APPLICATION_NOME_MAE=Maria Aparecida Souza
JARVIS_APPLICATION_NOME_PAI=José Carlos Souza
JARVIS_APPLICATION_NATURALIDADE=Belo Horizonte - MG

# Self-declared demographic fields -- also used to filter OUT listings
# explicitly reserved for a race/disability status you don't have (see
# job_matching.py's is_affirmative_action_only()).
JARVIS_APPLICATION_RACA_COR=Parda
JARVIS_APPLICATION_PCD=Não

# One salary expectation per role level -- detect_level() in base.py
# classifies each listing, and the adapter picks the matching field here at
# fill time, since "pretensão salarial" honestly differs by seniority.
JARVIS_APPLICATION_SALARY_ESTAGIO=R$ 2.000,00
JARVIS_APPLICATION_SALARY_JUNIOR=R$ 5.500,00
JARVIS_APPLICATION_SALARY_PLENO=R$ 9.000,00

JARVIS_APPLICATION_MARITAL_STATUS=Solteiro(a)

# Recurring, generic screening questions found live across many companies'
# Gupy forms -- see base.py's _FIELD_TERMS comment for the exact phrasings
# each of these matches.
JARVIS_APPLICATION_CNH=Sim, categoria B
JARVIS_APPLICATION_DISPONIBILIDADE_VIAGEM=Sim
JARVIS_APPLICATION_DISPONIBILIDADE_FDS=Não
JARVIS_APPLICATION_ESCOLARIDADE=Ensino superior completo
JARVIS_APPLICATION_CARGO_ATUAL=Analista de Dados Júnior na Empresa Exemplo Ltda.
JARVIS_APPLICATION_PARENTES_NA_EMPRESA=Não
JARVIS_APPLICATION_SEMESTRE_FORMATURA=6º semestre, formatura prevista para julho de 2026
